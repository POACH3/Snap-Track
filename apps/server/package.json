{
  "name": "@snaptrack/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && node --watch --env-file=.env apps/server/src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cd ../.. && node --env-file-if-exists=.env apps/server/src/platform/db/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@orpc/contract": "1.16.2",
    "@orpc/server": "1.16.2",
    "@snaptrack/contracts": "workspace:*",
    "@snaptrack/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11"
  }
}
