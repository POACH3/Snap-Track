# SnapTrack configuration (SPEC.md §4.5). Copy to .env for `pnpm dev`; production
# reads /opt/snap-track/config/.env instead. The server refuses to start if any
# value is missing or invalid. Relative paths are relative to the repo root.

# development | production | test. Production serves the built web app itself.
NODE_ENV=development

# Port SnapTrack listens on, always on 127.0.0.1. Production and development differ.
PORT=4310

# The LLM server relay's address and port (not oMLX directly; SPEC.md §6.3.1).
LLM_SERVER_URL=http://127.0.0.1:8080

# SnapTrack's own API key for the LLM server, so its usage is recorded under its name.
LLM_SERVER_API_KEY=replace-with-snaptrack-key

# The vision model's name as the LLM server knows it.
EXTRACTION_MODEL=Qwen3.6-35B-A3B-4bit

# How long to wait for one extraction request before counting it as failed (milliseconds).
EXTRACTION_TIMEOUT_MS=180000

# SQLite database file. Its folder is created by `pnpm db:migrate` if missing.
DATABASE_PATH=./data/snaptrack.db

# Folder for receipt images and imported files.
IMAGE_DIR=./data/images

# Key for hashing session tokens in the database, so a copy of the database can't be
# used to log in. Changing it signs everyone out. Use a different value in production.
# At least 32 random characters: `openssl rand -base64 48`.
SESSION_SECRET=replace-with-at-least-32-random-characters

# The address phones use: the Tailscale HTTPS URL in production, Vite's in development.
PUBLIC_ORIGIN=http://localhost:5173
